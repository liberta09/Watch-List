{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "devices": {
      ".read": "auth != null && auth.uid === '85lwGSAWPRXay3oSu4AQAfw2hM73'",
      "$deviceId": {
        ".write": "auth != null"
      }
    },

    "history": {
      ".read": "auth != null && auth.uid === '85lwGSAWPRXay3oSu4AQAfw2hM73'",
      ".write": "auth != null && auth.uid === '85lwGSAWPRXay3oSu4AQAfw2hM73'",
      "$deviceId": {
        "$eventId": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['event', 'timestamp'])"
        }
      }
    },

    "commands": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === '85lwGSAWPRXay3oSu4AQAfw2hM73'",
        "executed": {
          ".write": "auth != null && data.exists() && newData.val() === true"
        }
      }
    },

    "shared": {
      "$code": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['ownerUid','title','items']) && newData.child('ownerUid').val() === auth.uid"
      }
    }
  }
}
